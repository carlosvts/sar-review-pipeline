# chave gratuita do OpenAlex: https://help.openalex.org/api/authentication/
# sem ela, a cota diária é compartilhada por todo o IP
OPENALEX_API_KEY=

# opcional: sem ela o Semantic Scholar usa a cota compartilhada (muitos 429)
# https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=
# e-mail de contato para o polite pool da Crossref e o User-Agent das APIs
CONTACT_EMAIL=
